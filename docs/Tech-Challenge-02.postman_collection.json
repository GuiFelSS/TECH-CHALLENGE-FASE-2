      "item": [
        {
          "name": "Criar UserType",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const response = pm.response.json();",
                  "pm.test(\"Resposta contém id\", function () {",
                  "    pm.expect(response).to.be.an(\"object\");",
                  "    pm.expect(response.id).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "if (response.id) {",
                  "    pm.collectionVariables.set(\"userTypeId\", response.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usertypes",
